{
  // Всё, что исполняется в Node: юнит-тесты, сквозные тесты, конфиги Vite и
  // Playwright. Отдельным проходом, а не в tsconfig.json, потому что им нужны
  // типы Node (process, node:fs), а коду страницы они противопоказаны.
  //
  // Тянет их не только этот файл: на типы Node ссылается сам vite, а его
  // импортируют vite.config.ts и через vitest юнит-тесты. Окажись любой из
  // них в одном проходе с src/, там молча стали бы доступны process, Buffer
  // и node:fs, и такая ошибка ловилась бы только в браузере.
  //
  // src/ сюда тоже попадает - через импорты тестов, - но строго он
  // проверяется своим проходом, в tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client"]
  },
  "include": ["tests", "e2e", "vite.config.ts", "playwright.config.ts"]
}
