{
  "name": "solar-system",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "description": "Симуляция Солнечной системы: реальные расстояния, кеплеровские орбиты, свободный полёт",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
