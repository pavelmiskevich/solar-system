/**
 * Кольца: яркость и прозрачность на расстоянии от планеты.
 *
 * Кольцо — это не диск, а миллиарды ледяных обломков в одной плоскости.
 * Отсюда всё поведение: оно светится отражённым светом пропорционально
 * наклону плоскости к Солнцу, с освещённой стороны выглядит ярче, чем на
 * просвет, у края становится плотнее — луч зрения проходит сквозь большую
 * толщу, — и на нём лежит тень планеты.
 *
 * Требует noise.glsl и rings.glsl.
 */

#include <logdepthbuf_pars_fragment>

uniform vec3 uSunPosition;
uniform float uIrradianceScale;
/** Направление на Солнце в системе координат тела. */
uniform vec3 uSunBodyDirection;
/** Положение камеры в системе координат тела, км. */
uniform vec3 uCameraBodyPosition;
uniform vec3 uColor;
uniform float uEquatorial;
uniform float uPolar;

varying vec3 vBodyPosition;
varying vec3 vWorldPosition;

/**
 * Оптическая толщина кольца при полной плотности.
 *
 * Плотность полосы в данных — это «сколько в ней вещества», от нуля до
 * единицы, и оптическая толщина ей пропорциональна. Множитель подобран, а не
 * измерен, и честно было бы задать каждой полосе её собственное τ: у кольца B
 * оно доходит до двух с половиной, у C и деления Кассини держится около
 * десятой доли, и одним числом эти четыре порядка не связать. Такого поля в
 * данных нет, и полосы получают своё в пропорции: B выходит около 1.5, A —
 * 1.15, C — 0.45, деление Кассини — 0.19.
 *
 * Число выбрано по тому, что видно. Замер яркости по ансе при раскрытии
 * колец 26.7°: было C 5.6, B 41.4, Кассини 7.5, A 34.7 — то есть теневая
 * сторона повторяла освещённую, только тусклее. Стало C 9.1, B 1.9,
 * Кассини 9.0, A 4.4: B потемнело впятеро против C, полосы поменялись
 * местами, и при этом ни одна не пропала — чего и добивались. Вдвое большая
 * толщина давала правильный порядок, но гасила B и A в ноль.
 */
const float RING_OPTICAL_DEPTH = 1.6;

void main() {
  #include <logdepthbuf_fragment>

  float radius = length(vBodyPosition.xz);
  float density = ringDensity(radius);
  if (density < 0.004) discard;

  vec3 toSun = uSunPosition - vWorldPosition;
  float sunDistance = max(length(toSun), 1.0);
  float irradiance = uIrradianceScale / (sunDistance * sunDistance);

  // Поток на единицу площади кольца падает с наклоном плоскости к Солнцу.
  // В равноденствие на Сатурне кольца гаснут почти полностью — и это правда.
  float sunElevation = abs(uSunBodyDirection.y);

  vec3 viewDirection = normalize(vBodyPosition - uCameraBodyPosition);
  float lit = step(0.0, -viewDirection.y * uSunBodyDirection.y);

  // Синус угла между лучом зрения и плоскостью колец. У края он мал, и любой
  // путь сквозь кольцо становится длиннее во столько же раз.
  float mu = max(abs(viewDirection.y), 0.02);

  /*
   * С освещённой стороны кольцо отражает, с теневой — просвечивает, и это
   * два разных явления, а не одно, помноженное на число.
   *
   * Сквозь слой проходит exp(−τ/μ): чем плотнее полоса, тем меньше света
   * пробирается насквозь. Оттого рисунок колец с теневой стороны получается
   * негативом обычного — плотное кольцо B почти чёрное, а разреженные C и
   * деление Кассини светлые. На снимках «Кассини» с неосвещённой стороны они
   * ровно так и меняются местами, и это не эффект, а прямое следствие того,
   * что кольцо — не поверхность, а слой обломков.
   */
  float transmission = exp(-density * RING_OPTICAL_DEPTH / mu);
  float scatter = mix(transmission, 1.0, lit);

  float shadow = planetShadow(vBodyPosition, uSunBodyDirection, uEquatorial, uPolar);

  // У края луч зрения идёт вдоль плоскости и проходит сквозь большую толщу:
  // кольцо становится непрозрачнее, хотя вещества в нём не прибавилось.
  // Прозрачность одна с обеих сторон — вещества на луче столько же, с какой
  // стороны на него ни смотри, — и раньше здесь стоял множитель, делавший
  // теневую сторону прозрачнее. Он подменял собой пропускание; теперь
  // пропускание считается, и подмена не нужна.
  float grazing = clamp(density / max(abs(viewDirection.y), 0.08), 0.0, 1.0);

  vec3 color = uColor * density * irradiance * sunElevation * scatter * shadow;
  gl_FragColor = vec4(color, grazing);
}
