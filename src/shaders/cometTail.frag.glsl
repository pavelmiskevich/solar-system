#include <logdepthbuf_pars_fragment>

uniform vec3 uColor;
uniform float uIntensity;
/**
 * Отмена адаптации экспозиции.
 *
 * Экспозиция растёт в десятки раз с удалением от Солнца, а комета видна как
 * раз вблизи него. Без отмены хвост то выгорал бы в белое, то пропадал -
 * в зависимости от того, откуда на него смотрят.
 */
uniform float uExposure;

varying float vSide;
varying float vReach;

void main() {
  #include <logdepthbuf_fragment>

  // Поперёк хвост не имеет края: газ и пыль разрежены, и к краям ленты
  // свечение сходит на нет. Квадрат вместо линейного спада даёт ту самую
  // мягкую сердцевину, по которой хвост и узнаётся на снимках.
  float across = 1.0 - abs(vSide);
  across *= across;

  // Вдоль - гаснет к концу: чем дальше от ядра, тем реже вещество. У самого
  // ядра свечение не обрывается ступенькой, поэтому спад плавный.
  float along = 1.0 - vReach;
  along *= along;

  float a = across * along * uIntensity * uExposure;

  // Альфа единица, а не `a`: аддитивное смешивание в three - это
  // (SrcAlpha, One), и вклад уже домножен на альфу. Иначе яркость пошла бы
  // как a², и хвост пропал бы вместе с компенсацией экспозиции.
  gl_FragColor = vec4(uColor * a, 1.0);
}
