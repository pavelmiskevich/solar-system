// Клеточный шум Уорли для кратеров. Требует hash33 из noise.glsl.
//
// Кратер — это не пятно, а профиль: тёмное дно, светлый вал, резкая граница.
// Такой профиль естественно строится из расстояния до ближайшего зерна: у
// самого зерна дно, на расстоянии радиуса вал.
//
// Двадцать семь ячеек на вызов — дорого, и это осознанно. Кратеры видны только
// вблизи, а вблизи в кадре одно тело и мало пикселей на нём приходится на
// поверхность. Дешёвая замена — шум с модулем — даёт борозды, а не кратеры,
// и Луна перестаёт быть Луной.
vec4 cellular(vec3 p) {
  vec3 cell = floor(p);
  vec3 f = fract(p);

  float nearest = 8.0;
  float second = 8.0;
  vec2 nearestSeed = vec2(0.0);

  for (int x = -1; x <= 1; x++) {
    for (int y = -1; y <= 1; y++) {
      for (int z = -1; z <= 1; z++) {
        vec3 offset = vec3(float(x), float(y), float(z));
        // Зерно смещено внутри ячейки, иначе кратеры выстраиваются в решётку.
        vec3 seed = hash33(cell + offset) * 0.5 + 0.5;
        float d = length(offset + seed - f);

        if (d < nearest) {
          second = nearest;
          nearest = d;
          // Тот же хеш служит и приметой ячейки: по нему задаются размер
          // кратера и то, есть ли он вообще.
          nearestSeed = seed.yz;
        } else if (d < second) {
          second = d;
        }
      }
    }
  }

  return vec4(nearest, second, nearestSeed);
}

/**
 * Поле кратеров: возвращает высоту в долях глубины кратера, примерно −1…1.
 * Дно отрицательное, вал положительный, между ними склон.
 *
 * Кратеры разного калибра и не в каждой ячейке: поверхность, где кратеры
 * одинаковы и стоят сплошь, выглядит мячом для гольфа, а не Луной.
 */
float craterHeight(vec3 p) {
  vec4 c = cellular(p);

  // Четверть ячеек остаётся пустой — между кратерами должны быть промежутки.
  if (c.w < 0.26) return 0.0;

  float radius = mix(0.16, 0.42, c.z * c.z);

  float bowl = smoothstep(radius, radius * 0.15, c.x);
  float rim = smoothstep(radius * 1.4, radius, c.x) * smoothstep(radius * 0.7, radius, c.x);

  // Крупные кратеры глубже мелких — в природе глубина растёт с диаметром.
  return (rim * 1.2 - bowl) * (0.5 + radius);
}
