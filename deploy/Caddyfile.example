# Образец блока для раздачи сцены. Caddy сам получает и продлевает сертификат,
# отдельный certbot не нужен.
#
# Дописывается в конец /etc/caddy/Caddyfile отдельным блоком. Если на сервере
# уже есть другие сайты, их блоки не трогаются: Caddy выбирает блок по имени
# хоста, и более точное совпадение выигрывает у безымянного «:443».

solar-system.example.com {
  # Почта для ACME. Если в файле уже есть блок со своей почтой, стоит указать
  # ту же — тогда регистрация пойдёт от одного контакта.
  tls admin@example.com

  # Именно на симлинк, а не на каталог выпуска: перестановка симлинка
  # атомарна, и подмена версии происходит между запросами, а не посреди
  # отдачи страницы.
  root * /var/www/solar-system/current
  file_server
  encode gzip zstd

  # Имена файлов сборки содержат хеш содержимого: другое содержимое — другое
  # имя. Значит, кэшировать их можно навсегда.
  @assets path /assets/*
  header @assets Cache-Control "public, max-age=31536000, immutable"

  # А страница обязана проверяться каждый раз: её имя постоянно, и
  # закэшированная она навсегда закрепит ссылки на старую сборку.
  #
  # Корень «/» перечислен явно, и это не перестраховка: сопоставление идёт по
  # пути запроса, а index.html подставляет уже file_server — правило только для
  # «/index.html» на запрос «/» не сработает. Проверено на живом сервере:
  # заголовка не было вовсе.
  @html path / /index.html
  header @html Cache-Control "no-cache"
}
